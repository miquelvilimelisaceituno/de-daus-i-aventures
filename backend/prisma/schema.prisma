generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Campaign {
  id          String    @id @default(uuid(7)) @db.Uuid
  name        String    @db.VarChar(60)
  description String?
  imageUrl    String?   @map("image_url")
  mapImageUrl String?   @map("map_image_url")
  inviteCode  String    @unique @map("invite_code") @db.VarChar(8)
  inviteOpen  Boolean   @default(true) @map("invite_open")
  maxPlayers  Int       @default(6) @map("max_players")
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@map("campaigns")
}

model User {
  id        String   @id @db.VarChar(128) // uid de Firebase (D9)
  name      String   @db.VarChar(40)
  avatarUrl String?  @map("avatar_url")
  isAdmin   Boolean  @default(false) @map("is_admin")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("users")
}
