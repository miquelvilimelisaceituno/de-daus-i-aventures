NODE_ENV=development
PORT=3000
# Neon: cadena pooled (la usa l'app)
DATABASE_URL=
# Neon: cadena directa (la usa Prisma per a les migracions)
DIRECT_URL=
# Orígens del frontend que poden cridar l'API, separats per comes
CORS_ORIGINS=http://localhost:4200
# Firebase Admin (compte de servei). No calen amb NODE_ENV=test (D21)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=